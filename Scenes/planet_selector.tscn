[node name="LogName" type="Label" parent="PlanetSelector/DatalogMenu/Panel/LogPanel" unique_id=1358287881]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.04302162
anchor_top = 0.054347824
anchor_right = 0.66165495
anchor_bottom = 0.10869565
offset_right = 0.30490112
offset_bottom = 4.0000076
theme_override_font_sizes/font_size = 64
text = "Log: 2080-2070"
metadata/_edit_use_anchors_ = true

[node name="LogContents" type="RichTextLabel" parent="PlanetSelector/DatalogMenu/Panel/LogPanel" unique_id=852101273]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.04455632
anchor_top = 0.22
anchor_right = 0.95521367
anchor_bottom = 0.9433962
text = "The third world war ended in 2070. Its winner was no sovereign nation. It was a medicine-manufacturing company known as Rediankh. They had managed to create technologies which could dispel radioactive energy, cure radiation poisoning and either physically condition people to paritally resist radiation or genetically modify embryos to create fully radiation immune humans. In the 1940s, humans had figured out a way to eradicate all life, 120 years later they had figured out how to resist annihilation. All sovereign nations tried to recreate Rediankh's technologies with no success. It seemed as the researchers working there had capabilities far beyond human. Rediankh - controlled by a small private group of scientists - started broadcasting signals that they were giving out free aid to anyone affected by the nuclear war, as long as they could make their way to a Revival Point - one of the company's many outposts created in any countries which wished to be put on a list of Rediankh \"allies\". Every nation was promised access to Rediankh's tech, but none got it. It was all merely a front for creating a wide network of points all of which would be used to recruit people into the ranks of the company. Slowly, all nations withered, diminishing in size, while the company grew larger and larger. How couldn't it, when joining was such a good deal for the average person? A shelter, food, life-saving medication. Being a so called Lifeforce Unit was an utopia when the alternatives were all certain death. When the few sovereign nations left realised the truth, it was already too late. They stopped fighting and turned on Rediankh, forming an alliance against them. But it was too little, too late. Rediankh had a population higher than that of the entire alliance and their Lifeforce troops were superhumans. As the last nation fell, so did the concept of politics with it. "
metadata/_edit_use_anchors_ = true

