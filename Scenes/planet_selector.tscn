[node name="Message" type="RichTextLabel" parent="PlanetSelector/Comms/Panel/MessageData" unique_id=513355048]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.04455632
anchor_top = 0.22
anchor_right = 0.95521367
anchor_bottom = 0.9433962
text = "Salutations gentlemen. I am Oryx Talanthir, the ruler of planet Neos. Our home is being assaulted by unknown, unmarked foes. Years ago, this planet used to be an utopia ruled by a super-AI, but a paramillitary group known as Anima attacked us and destroyed it. Now we are left without protection and must fight our enemies with people, not drones. We have sustained heavy casualties and are in desperate need of support. Your mission is to take down the base of operations of our foes."
metadata/_edit_use_anchors_ = true

