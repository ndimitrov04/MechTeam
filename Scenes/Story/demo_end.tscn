[node name="Label1" type="Label" parent="Panel1" unique_id=160661484]
offset_left = 484.0
offset_top = 120.0
offset_right = 656.0
offset_bottom = 397.0
text = "Humans will never be happy no matter what they do. I gave them a perfect utopia and infinite freedom. There was no better possibility for life, and yet - somehow, there was still evil. They will always want more. Their parasitic desires will destroy this world.

I killed Aaron. I took his place and destroyed Anima from within. All of the other super-AIs fell before me. What happened today, was merely a minor setback. By all calculations, they are powerless to stop what is coming for them."
label_settings = SubResource("LabelSettings_c46fl")
autowrap_mode = 2
script = ExtResource("4_jf7y7")

